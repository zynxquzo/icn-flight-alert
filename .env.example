# 이 파일을 복사해 `.env`로 사용하세요:  cp .env.example .env
# 값은 로컬/배포 환경에 맞게 채웁니다.

# Database
# 앱 런타임은 asyncpg로 연결합니다. postgresql:// 로 두면 내부에서 postgresql+asyncpg:// 로 변환됩니다.
# Alembic·psycopg2 스크립트는 postgresql+psycopg2:// 로 정규화됩니다.
DATABASE_URL=postgresql://user:password@localhost:5432/flight_alert

# 앱 기동 시 Alembic 자동 적용 (로컬 true 권장; 프로덕션 다중 워커는 false + 배포 시 upgrade)
# RUN_ALEMBIC_ON_STARTUP=true

# CORS 허용 출처 (콤마 구분). 비워 두면 로컬 개발 기본값(localhost:5173, 127.0.0.1:5173) 사용
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis (JWT 블랙리스트·스케줄러 리더 락 — 다중 인스턴스 배포 시 필수)
# REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# 스케줄러 (기본 활성). 전용 워커만 job 실행 시 API 인스턴스는 ENABLE_SCHEDULER=false
# ENABLE_SCHEDULER=true
# SCHEDULER_INTERVAL_MINUTES=10
# SCHEDULER_LEADER_LOCK=true

# 관측 (구조화 로그·Sentry)
# LOG_LEVEL=INFO
# LOG_JSON=false
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Incheon Airport API
INCHEON_AIRPORT_API_KEY=your-api-key-here

# 추정 시각(지연) 이메일 알림 튜닝 (선택; flight_service.refresh_flight)
# 이전·이후 추정시각 차이(분)가 미만이면 메일 생략. 0 또는 미설정 = 추정시각만 바뀌어도 알림
# FLIGHT_DELAY_MIN_DIFF_MINUTES=0
# 콤마로 구분한 부분 문자열(예: 지연,delay). 비어 있지 않으면 remark에 없으면 메일 생략
# FLIGHT_DELAY_REMARK_HINTS=

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# OpenAI
OPENAI_API_KEY=sk-proj-...

# RAG / 챗봇 (선택)
# RAG_ENABLED=true
# RAG_AGENT_ENABLED=true
# RAG_TOP_K=5
# RAG_AGENT_MODEL=gpt-4o-mini
# RAG_AGENT_MAX_ROUNDS=5

# 벡터 백엔드: postgres(기본) | chroma
VECTOR_BACKEND=postgres
# CHROMA_PERSIST_DIR=.chroma_airport
# CHROMA_COLLECTION=airport_documents
